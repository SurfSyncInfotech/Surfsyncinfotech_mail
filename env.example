# Copy the names you need into .env.local. Do not commit real values.

# Public key from the Razorpay dashboard. Safe to expose in the browser checkout.
RAZORPAY_KEY_ID=

# Secret key. Server only. Never put this in the browser or in git.
RAZORPAY_KEY_SECRET=

# From Razorpay webhook settings. Used to confirm payment.captured.
RAZORPAY_WEBHOOK_SECRET=

# Shared secret for the super-admin APIs. At least 24 characters.
# Send it as: Authorization: Bearer <this value>
ADMIN_API_KEY=

# Optional. Set this only if the super-admin site is on another origin.
# Example: http://localhost:3001
ADMIN_CORS_ORIGIN=

# MySQL database you already created. Do not commit the real values.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Auth. Secret must be at least 24 characters. Super admin is created once from these two values.
AUTH_JWT_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Local testing only. Set to true to include the reset token in the response. Leave empty in production.
RETURN_RESET_TOKEN=

# Optional. Total disk the super-admin dashboard compares against. Defaults are 1000 GB and an alert at 80 percent.
SERVER_STORAGE_GB=1000
STORAGE_ALERT_PERCENT=80

# DNS instructions a company admin must add. A real domain is verified only when public DNS matches.
MAIL_MX_HOST=mail.surfsyncinfotech.xyz
SPF_INCLUDE=mail.surfsyncinfotech.xyz

# Stalwart Mail Server Configuration
# Set these when deploying to mail.surfsyncinfotech.xyz
STALWART_HOST=mail.surfsyncinfotech.xyz
STALWART_PORT=8080
STALWART_ADMIN_USERNAME=admin
STALWART_ADMIN_PASSWORD=
STALWART_USE_HTTPS=true
