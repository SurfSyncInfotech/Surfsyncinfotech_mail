# Copy the names you need into .env.local. Do not commit real values.

# Public key from the Razorpay dashboard. Safe to expose in the browser checkout.
RAZORPAY_KEY_ID=

# Secret key. Server only. Never put this in the browser or in git.
RAZORPAY_KEY_SECRET=

# From Razorpay webhook settings. Used to confirm payment.captured.
RAZORPAY_WEBHOOK_SECRET=

# Shared secret for the super-admin APIs. At least 24 characters.
# Send it as: Authorization: Bearer <this value>
ADMIN_API_KEY=

# Optional. Set this only if the super-admin site is on another origin.
# Example: http://localhost:3001
ADMIN_CORS_ORIGIN=
